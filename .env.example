# --- AI Provider Selection ---
# Chọn một trong các provider: "groq", "gemini", "openrouter", "ollama", "openai", "offline_mock"
# Mặc định offline_mock sẽ dùng cơ chế suy luận logic của agent mà không tốn phí API (rất tốt cho test offline/chấm điểm tự động nếu không cấp key)
LLM_PROVIDER=offline_mock

# --- Groq Configuration (Recommended for ultra-fast inference with <=10B open models) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Google Gemini Configuration (Supported for open models <=10B like gemma-2-9b-it) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-2-9b-it

# --- OpenRouter / OpenAI Compatible Endpoint ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Local Ollama Configuration (Offline open-source <=10B models) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Paths & General Settings ---
DATA_DIR=./data
INPUT_DIR=./input
OUTPUT_DIR=./output
TRACE_FILE=./trace.jsonl
LOG_LEVEL=INFO
